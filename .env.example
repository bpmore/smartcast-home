# Copy to .env and fill in your values. NEVER commit .env.

# --- TV (required) ---
VIZIO_IP=192.168.1.50:7345        # your TV's LAN IP + SmartCast API port (usually 7345)
VIZIO_DEVICE_TYPE=tv
VIZIO_AUTH=                        # pairing token (see README "Pair with the TV")

# --- Roku (optional: lets app tiles launch on a Roku over HDMI) ---
ROKU_IP=192.168.1.51:8060          # your Roku's LAN IP + ECP port (8060)

# --- Custom home screen (required for the launcher + watcher) ---
# THIS host's LAN IP + the port below, serving home.html. The TV loads this URL.
LAUNCHER_URL=http://192.168.1.60:8750/home.html

# --- Weather (Open-Meteo, no key needed) ---
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_TZ=America/New_York
WEATHER_CITY=                      # optional label; not shown on screen by default

# --- Background images (optional) ---
# Free key from https://www.pexels.com/api/ enables themed photos.
# Leave blank to fall back to random Picsum images (no key).
PEXELS_KEY=
# Optional: override the built-in theme list (pipe-separated search terms)
# BG_THEMES=nature|beach|Seattle skyline|New York City skyline|mountains
